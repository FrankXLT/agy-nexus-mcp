[Unit]
Description=agy-host-bridge - Antigravity Host Companion Bridge (agentapi & git-inspect)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/ag-bridge-mcp/secrets.env
Environment=PYTHONUNBUFFERED=1
Environment=HOST_BRIDGE_BIND_HOST=127.0.0.1
Environment=HOST_BRIDGE_BIND_PORT=8098
ExecStart=/usr/bin/python3 %h/agentic_workspace/projects/agy-nexus-mcp/host_bridge/agy_host_bridge.py
Restart=always
RestartSec=5
WorkingDirectory=%h/agentic_workspace/projects/agy-nexus-mcp

[Install]
WantedBy=default.target
