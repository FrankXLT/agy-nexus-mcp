{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FrankXLT/agy-nexus-mcp/blob/main/src/agy_nexus/data/schemas/cost_ledger.schema.json",
  "title": "AGY-Nexus Effective-Dated Cost Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_revision",
    "updated_at",
    "currency",
    "micros_per_usd",
    "tokens_per_rate_unit",
    "models"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "updated_at": {
      "type": "string",
      "pattern": "^(?!.*\\n)\\d{4}-\\d{2}-\\d{2}$"
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "micros_per_usd": {
      "type": "integer",
      "const": 1000000
    },
    "tokens_per_rate_unit": {
      "type": "integer",
      "const": 1000000
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": false,
      "patternProperties": {
        "^(?!.*\\n)[a-z][a-z0-9_]{1,47}$": {
          "$ref": "#/$defs/ledgerModel"
        }
      }
    }
  },
  "$defs": {
    "safeHttpsUrl": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512,
      "pattern": "^(?!.*\\n)https://[A-Za-z0-9.-]+(?:[/?#][^\\s<>\\[\\]()|`\"'\\\\;]*)?$"
    },
    "ledgerModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "source_url",
        "verified_at",
        "rate_epochs"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_url": {
          "$ref": "#/$defs/safeHttpsUrl"
        },
        "verified_at": {
          "type": "string",
          "pattern": "^(?!.*\\n)\\d{4}-\\d{2}-\\d{2}$"
        },
        "rate_epochs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/rateEpoch"
          }
        }
      }
    },
    "rateEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_from",
        "effective_to",
        "input_micros",
        "output_micros",
        "cache_read_micros",
        "source_url",
        "verified_at",
        "note"
      ],
      "properties": {
        "effective_from": {
          "type": "string",
          "pattern": "^(?!.*\\n)\\d{4}-\\d{2}-\\d{2}$"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!.*\\n)\\d{4}-\\d{2}-\\d{2}$"
        },
        "input_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000000
        },
        "output_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000000
        },
        "cache_read_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000000
        },
        "source_url": {
          "$ref": "#/$defs/safeHttpsUrl"
        },
        "verified_at": {
          "type": "string",
          "pattern": "^(?!.*\\n)\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        }
      }
    }
  }
}
